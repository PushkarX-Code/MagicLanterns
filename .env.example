# Built into the app at compile time; never shown in Settings and never committed.
#
# Best: deploy the metadata proxy (worker/) and set its URL here. The keys then live only on the
# server and nothing secret ships inside the app.
MAIN_VITE_META_PROXY_URL=
#
# Local builds without a proxy: the keys below are built in (scrambled). Both are free:
#   TMDB: https://www.themoviedb.org/settings/api
#   OMDb: https://www.omdbapi.com/apikey.aspx
MAIN_VITE_TMDB_API_KEY=
MAIN_VITE_OMDB_API_KEY=
